      }
    },
    "This edit exceeded the bounded Undo history. The edit was kept, but earlier Undo and Redo steps were cleared." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This edit exceeded the bounded Undo history. The edit was kept, but earlier Undo and Redo steps were cleared."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此次编辑超出了受限的撤销历史。编辑已保留，但较早的撤销和重做步骤已清除。"
          }
        }
      }
    },
    "This is a case-only rename. Riffa uses a hidden, unguessable same-directory intermediate name and two exclusive atomic renames so both case-sensitive and case-insensitive volumes fail closed." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is a case-only rename. Riffa uses a hidden, unguessable same-directory intermediate name and two exclusive atomic renames so both case-sensitive and case-insensitive volumes fail closed."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是仅更改大小写的重命名。Riffa 使用同目录下隐藏且不可猜测的中间名称，并执行两次独占原子重命名，使区分与不区分大小写的卷都能在失败时安全中止。"
          }
        }
      }
    },
    "This only enables the explicit Save button; connecting never writes to Keychain." : {
