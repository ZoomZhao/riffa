        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 文件事务可能已更改%2$@。重试前，请检查“操作历史记录”和 %3$@ 中的备份。"
          }
        }
      }
    },
    "%@ The file transaction may already have moved or restored paths. Inspect Operation History and both compared roots before retrying." : {
